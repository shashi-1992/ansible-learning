#!/usr/bin/env python3
"""
Minimal AIOps-style pipeline (educational):
  prepare -> baseline detect -> evaluate vs ground truth -> manifest.

Uses synthetic KPI time series with injected anomalies (labels for teaching).
Run: python pipeline.py
"""
from __future__ import annotations

import json
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import numpy as np
import pandas as pd

ARTIFACTS_DIR = Path(__file__).resolve().parent / "artifacts"
RNG = np.random.default_rng(42)
N_POINTS = 1440  # e.g. minute buckets for a day
WINDOW = 60  # rolling baseline window
Z_THRESHOLD = 3.0  # static threshold for "alert"


def stage_prepare() -> pd.DataFrame:
    """Build synthetic KPI with rare spikes + ground-truth anomaly flag (for eval only)."""
    print("[1/4] prepare: synthetic KPI time series")
    ARTIFACTS_DIR.mkdir(parents=True, exist_ok=True)
    t = np.arange(N_POINTS, dtype=np.int64)
    # Normal load ~50 +/- noise
    base = 50.0 + RNG.normal(0, 2.0, size=N_POINTS)
    truth = np.zeros(N_POINTS, dtype=np.int8)
    # Inject 8 anomaly bursts (sustained elevation)
    for start in [120, 310, 450, 620, 800, 950, 1100, 1300]:
        base[start : start + 15] += RNG.uniform(12, 22)
        truth[start : start + 15] = 1
    df = pd.DataFrame(
        {
            "timestamp_minute": t,
            "kpi_value": base.astype(np.float64),
            "ground_truth_anomaly": truth,
        }
    )
    path = ARTIFACTS_DIR / "raw_kpi.csv"
    df.to_csv(path, index=False)
    print(f"      wrote {path} ({len(df)} rows)")
    return df


def stage_detect(df: pd.DataFrame) -> pd.DataFrame:
    """
    Rolling z-score vs local baseline (AIOps pattern: deviation from 'normal').
    Does NOT use ground_truth in scoring (operational realism).
    """
    print("[2/4] detect: rolling mean/std baseline + z-score alerts")
    v = df["kpi_value"].astype(float)
    roll_mean = v.rolling(window=WINDOW, min_periods=WINDOW).mean()
    roll_std = v.rolling(window=WINDOW, min_periods=WINDOW).std().replace(0, np.nan)
    z = (v - roll_mean) / roll_std
    fired = (z.abs() > Z_THRESHOLD).fillna(False)
    out = df[["timestamp_minute", "kpi_value"]].copy()
    out["z_score"] = z
    out["alert_fired"] = fired.astype(int)
    path = ARTIFACTS_DIR / "alerts.csv"
    out.to_csv(path, index=False)
    n_alerts = int(out["alert_fired"].sum())
    print(f"      wrote {path} (alerts fired: {n_alerts})")
    return out


def stage_evaluate(df: pd.DataFrame, alerts: pd.DataFrame) -> dict[str, Any]:
    """Compare alerts to injected ground truth (teaching metric only)."""
    print("[3/4] evaluate: precision / recall / F1 vs ground truth")
    y_true = df["ground_truth_anomaly"].astype(int).values
    y_pred = alerts["alert_fired"].astype(int).values
    tp = int(((y_true == 1) & (y_pred == 1)).sum())
    fp = int(((y_true == 0) & (y_pred == 1)).sum())
    fn = int(((y_true == 1) & (y_pred == 0)).sum())
    prec = tp / (tp + fp) if (tp + fp) else 0.0
    rec = tp / (tp + fn) if (tp + fn) else 0.0
    f1 = (2 * prec * rec / (prec + rec)) if (prec + rec) > 0 else 0.0
    metrics = {
        "precision": round(prec, 4),
        "recall": round(rec, 4),
        "f1": round(f1, 4),
        "true_positives": tp,
        "false_positives": fp,
        "false_negatives": fn,
        "z_threshold": Z_THRESHOLD,
        "rolling_window": WINDOW,
    }
    path = ARTIFACTS_DIR / "metrics.json"
    path.write_text(json.dumps(metrics, indent=2), encoding="utf-8")
    print(f"      metrics -> {path}  (F1={metrics['f1']})")
    return metrics


def stage_manifest(metrics: dict[str, Any]) -> None:
    print("[4/4] manifest")
    manifest = {
        "run_id": datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ"),
        "domain": "synthetic_kpi_rolling_zscore",
        "artifacts_dir": str(ARTIFACTS_DIR.resolve()),
        "metrics": metrics,
        "python": sys.version.split()[0],
    }
    path = ARTIFACTS_DIR / "run_manifest.json"
    path.write_text(json.dumps(manifest, indent=2), encoding="utf-8")
    print(f"      wrote {path}")
    print("Done.")


def main() -> None:
    df = stage_prepare()
    alerts = stage_detect(df)
    metrics = stage_evaluate(df, alerts)
    stage_manifest(metrics)


if __name__ == "__main__":
    main()

