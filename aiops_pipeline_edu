#!/usr/bin/env python3
"""One-file export: repo-root AIOps doc + all files under simple_aiops_pipeline/ (Base64 for binaries)."""
from __future__ import annotations

import base64
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent
REPO_ROOT = ROOT.parent
OUT = ROOT / "PROJECT_BUNDLE.txt"
SKIP_DIRS = {".venv", "__pycache__", ".git"}
SKIP_FILES = {"PROJECT_BUNDLE.txt"}
TEXT_SUFFIXES = {".py", ".md", ".txt", ".json", ".csv", ".yml", ".yaml", ".toml", ".ini", ".cfg", ".jsonl"}
MAX_TEXT_BYTES = 512_000
MAX_BINARY_EMBED_BYTES = 5 * 1024 * 1024

EXTRA_PATHS: list[Path] = [REPO_ROOT / "SIMPLE_AIOPS_PIPELINE_PROJECT.md"]


def is_probably_text(path: Path, data: bytes) -> bool:
    if path.suffix.lower() in TEXT_SUFFIXES:
        return True
    if b"\x00" in data[:8192]:
        return False
    try:
        data[:8192].decode("utf-8")
        return True
    except UnicodeDecodeError:
        return False


def append_section(lines: list[str], file_path: Path, raw: bytes) -> None:
    lines.append(f"=== {file_path.resolve()} ===")
    if len(raw) > MAX_BINARY_EMBED_BYTES:
        lines.append(f"<omitted: {len(raw)} bytes>\n")
        return
    suffix = file_path.suffix.lower()
    if suffix in {".joblib", ".pkl", ".pickle"}:
        lines.append(f"<binary {len(raw)} bytes — Base64 below>")
        lines.append("BEGIN_BASE64")
        b64 = base64.standard_b64encode(raw).decode("ascii")
        for i in range(0, len(b64), 76):
            lines.append(b64[i : i + 76])
        lines.append("END_BASE64\n")
        return
    if len(raw) > MAX_TEXT_BYTES:
        lines.append(f"<omitted: {len(raw)} bytes>\n")
        return
    if is_probably_text(file_path, raw):
        try:
            text = raw.decode("utf-8")
        except UnicodeDecodeError:
            text = None
        if text is not None:
            if not text.endswith("\n"):
                text += "\n"
            lines.append(text)
            return
    lines.append(f"<binary {len(raw)} bytes — Base64>")
    lines.append("BEGIN_BASE64")
    b64 = base64.standard_b64encode(raw).decode("ascii")
    for i in range(0, len(b64), 76):
        lines.append(b64[i : i + 76])
    lines.append("END_BASE64\n")


def main() -> None:
    lines: list[str] = [
        "# simple_aiops_pipeline — full bundle",
        f"# PIPELINE_ROOT (absolute): {ROOT}",
        f"# REPO_ROOT (absolute): {REPO_ROOT}",
        f"# Generated (UTC): {datetime.now(timezone.utc).isoformat()}",
        "# Skipped dirs: " + ", ".join(sorted(SKIP_DIRS)),
        "# Skipped file: PROJECT_BUNDLE.txt",
        "",
    ]
    extra_n = 0
    for extra in EXTRA_PATHS:
        if extra.is_file():
            extra_n += 1
            append_section(lines, extra, extra.read_bytes())
            lines.append("")
    paths = sorted(
        p
        for p in ROOT.rglob("*")
        if p.is_file()
        and not any(part in SKIP_DIRS for part in p.relative_to(ROOT).parts)
    )
    n = 0
    for path in paths:
        if path.name in SKIP_FILES:
            continue
        n += 1
        append_section(lines, path, path.read_bytes())
    OUT.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"Wrote {OUT.resolve()} ({n} files + {extra_n} doc(s); {OUT.stat().st_size} bytes)")


if __name__ == "__main__":
    main()

