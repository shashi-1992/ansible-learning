SSHCONFIG_SRC="files/sshconfig"
TMUXCONF_SRC="files/tmux.conf"
VIMCONFIG_SRC="files/vimrc"
AWS_CONFIG_TPL="tmpl/aws.config.tpl"

config_setup() {
    # Example usage:
    # config_setup exotel exotel
    # config_setup root root
    local user="$1"
    local group="$2"

    if [[ -z "$user" || -z "$group" ]]; then
        echo "Usage: config_setup <user> <group>"
        return 1
    fi

    echo "Configuring setup for user: $user, group: $group..."

    # Check if group exists; if not, create it
    if ! getent group "$group" &>/dev/null; then
        echo "Group $group does not exist. Creating it..."
        groupadd "$group"
        if [[ $? -ne 0 ]]; then
            echo "Failed to create group $group."
            return 1
        fi
    fi

    # Check if user exists; if not, create it and assign to the group
    if ! id "$user" &>/dev/null; then
        echo "User $user does not exist. Creating it..."
        useradd -m -s /bin/bash -g "$group" "$user"
        if [[ $? -ne 0 ]]; then
            echo "Failed to create user $user."
            return 1
        fi
    fi

    # Create required directories
    local dirs=("/home/$user/.ssh/" "/etc/skel/.ssh/" "/tmp/list" "/home/$user/.aws")
    for dir in "${dirs[@]}"; do
        mkdir -p "$dir"
        chmod 0755 "$dir"
        chown "$user:$group" "$dir"
    done
    chmod 0777 /tmp/list  # Specific permission for /tmp/list

    # Copy files for the specified user
    echo "Copying bashrc configuration files for $user..."
    cp "$BASHRC_SRC" "/home/$user/.bashrc"
    chmod 0644 "/home/$user/.bashrc"
    chown "$user:$group" "/home/$user/.bashrc"

    echo "Copying ssh configuration files for $user..."
    cp "$SSHCONFIG_SRC" "/home/$user/.ssh/config"
    chmod 0644 "/home/$user/.ssh/config"
    chown "$user:$group" "/home/$user/.ssh/config"

    echo "Copying tmux configuration files for $user..."
    cp "$TMUXCONF_SRC" "/home/$user/.tmux.conf"
    chmod 0644 "/home/$user/.tmux.conf"
    chown "$user:$group" "/home/$user/.tmux.conf"

    echo "copying vim configuration files for $user..."
    mkdir -p "/home/$user/.vim/backup"
    cp "$VIMCONFIG_SRC" "/home/$user/.vimrc"
    chmod 0644 "/home/$user/.vimrc"
    chown "$user:$group" "/home/$user/.vimrc"

    echo "copying aws configuration files for $user..."
    AWS_REGION=$(curl -s http://169.254.169.254/latest/meta-data/placement/region)
    mkdir -p "/home/$user/.aws"
    cat "$AWS_CONFIG_TPL" | envsubst > aws.config
    cp aws.config "/home/$user/.aws/config"
    chmod 0644 "/home/$user/.aws/config"
    chown -R "$user:$group" "/home/$user/.aws/"
    echo "Configuration setup for $user completed!"
}

setup_root() {
    echo "Copying bashrc configuration files for root..."
    cp "$BASHRC_SRC" "/root/.bashrc"
    chmod 0644 "/root/.bashrc"
    chown "root:root" "/root/.bashrc"

    echo "Copying ssh configuration files for root..."
    cp "$SSHCONFIG_SRC" "/root/.ssh/config"
    chmod 0644 "/root/.ssh/config"
    chown "root:root" "/root/.ssh/config"

