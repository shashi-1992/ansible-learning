#!/usr/bin/env bash
set -euo pipefail

export BUILD_NUMBER=$(date +%s)

if [ -n "${DEBUG:-}" ]; then
    export ENABLE_DEBUG=" -debug "
else
    export ENABLE_DEBUG=" "
fi
help_function() {
    echo "Usage:source $0 [-c Cluster] [-v VPC_Name] [-e Environment] [-s Subnet] [-r Packer Role for Instance] [-t Template]"
    echo ""
    echo "Create the AMI for Specific Environment for Exotel"
    echo "Supported environments for now: integration, sgp, mum"
    echo "Options:"
    echo "  -c  Cluster to build the AMI (required)"
    echo "  -v  VPC to use for creating the instance for AMI Creation (required)"
    echo "  -e  Environment Name for AMI Creation (required)"
    echo "  -s  Subnet for the instance (required)"
    echo "  -r  Role for the instance created by packer (required)"
    echo "  -t  Template for the AMI Creation"
    echo "  -h  Display this help message"
    echo "Example: bash $0 -c qa -v vpc_us3-requestor -e qa -s bastion-us3-private-us-west-2b -r qa_ec2_role -t 'exotel-qa-eks-usw2.json'"
}

while getopts "c:v:e:s:r:t: h" flag
do
    case "${flag}" in
        c) export CLUSTER=${OPTARG};;
        v) export VPC_NAME="${OPTARG}";;
        e) export ENVIRONMENT="${OPTARG}";;
        s) export SUBNET_NAME="${OPTARG}";;
        r) export PACKER_ROLE="${OPTARG}";;
        t) export TEMPLATE="${OPTARG}";;
        h) help_function;exit 0;;
        *) echo "Undefined option: ${flag}";;
    esac
done


if [[ -z "${CLUSTER:-}" || -z "${VPC_NAME:-}" || -z "${ENVIRONMENT:-}" || -z "${SUBNET_NAME:-}" || -z "${PACKER_ROLE:-}" || -z "${TEMPLATE:-}" ]]; then
  echo "❌ Missing required arguments."
  help_function
fi

echo "🔨 Starting AMI build with:"
echo "  Cluster:     $CLUSTER"
echo "  VPC:         $VPC_NAME"
echo "  Environment: $ENVIRONMENT"
echo "  Subnet:      $SUBNET_NAME"
echo "  IAM Role:    $PACKER_ROLE"
echo "  Template:    $TEMPLATE"
echo "  Build #:     $BUILD_NUMBER"
echo
echo "─────────────────────────────"
./bin/packer init .
./bin/packer build -var "cluster=${CLUSTER}" -var "vpc_name=${VPC_NAME}" -var "environment=${ENVIRONMENT}" -var "subnet_name=${SUBNET_NAME}"${ENABLE_DEBUG}"${TEMPLATE}"

