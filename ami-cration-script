#!/usr/bin/env python3
"""Emit AMI_CREATION_BUNDLE.txt: absolute paths + file contents (text; large files truncated)."""
from __future__ import annotations

from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent
OUT = ROOT / "AMI_CREATION_BUNDLE.txt"
SKIP_NAMES = {OUT.name, ".git"}
MAX_BYTES = 400_000  # per file cap in bundle


def main() -> None:
    lines: list[str] = [
        "# ami-creation — full tree bundle",
        f"# ROOT (absolute): {ROOT}",
        f"# Generated (UTC): {datetime.now(timezone.utc).isoformat()}",
        "",
    ]
    paths = sorted(
        p
        for p in ROOT.rglob("*")
        if p.is_file() and not any(x in {".git", "__pycache__"} for x in p.parts)
    )
    n = 0
    for path in paths:
        if path.resolve() == OUT.resolve() or path.name in SKIP_NAMES or ".git" in path.parts:
            continue
        n += 1
        ap = path.resolve()
        try:
            raw = ap.read_bytes()
        except OSError as e:
            lines.append(f"=== {ap} ===\n<read error: {e}>\n")
            continue
        lines.append(f"=== {ap} ===")
        if len(raw) > MAX_BYTES:
            lines.append(f"<truncated: {len(raw)} bytes, showing first {MAX_BYTES}>\n")
            raw = raw[:MAX_BYTES]
        try:
            text = raw.decode("utf-8")
        except UnicodeDecodeError:
            lines.append(f"<binary {len(raw)} bytes, not included as text>\n")
            continue
        if not text.endswith("\n"):
            text += "\n"
        lines.append(text)
    OUT.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"Wrote {OUT} ({n} files, {OUT.stat().st_size} bytes)")


if __name__ == "__main__":
    main()

