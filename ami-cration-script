#!/bin/bash

# Get the list of all users from /etc/passwd
# Adjust to include only users with valid home directories (e.g., not system users)
for USER_HOME in $(awk -F: '($3 >= 1000 && $7 !~ /nologin|false/) {print $6}' /etc/passwd); do
    BACKUP_DIR="$USER_HOME/.vim/backup"
    # Check if the backup directory exists for the user
    if [ -d "$BACKUP_DIR" ]; then
        echo "Cleaning up old backup files in $BACKUP_DIR for user $(basename $USER_HOME)..."
        # Find and delete files older than 10 days
        echo "find \"$BACKUP_DIR\" -type f -mtime +10 -exec rm -f {} \;"
        echo "Cleanup complete for user $(basename $USER_HOME)."
    else
        echo "Backup directory $BACKUP_DIR does not exist for user $(basename $USER_HOME). Skipping..."
    fi
done

