BIN_DIR := ./bin
PACKER_BIN := $(BIN_DIR)/packer
AWSM_DIR := ./awsm

# Targets
.PHONY: all ami mum sgp packer install-packer mum-eks sgp-eks integration-eks awsm install-awsm packer install-packer ireland-eks

# Default target: run all
all: awsm packer integration-eks mum-eks sgp-eks integration mum sgp

packer:
	@if [ ! -f "$(PACKER_BIN)" ]; then \
		$(MAKE) install-packer; \
	fi

awsm:
	@if [ ! -f "$(AWSM_DIR)" ]; then \
		$(MAKE) install-awsm; \
	fi

install-packer:
	@echo "Installing Packer $(PACKER_VERSION)..."
	@mkdir -p $(BIN_DIR)
	@curl -sL https://releases.hashicorp.com/packer/$(PACKER_VERSION)/packer_$(PACKER_VERSION)_linux_amd64.zip -o /tmp/packer.zip
	@unzip -o /tmp/packer.zip -d $(BIN_DIR)
	@chmod +x $(PACKER_BIN)
	@rm /tmp/packer.zip
	@echo "Packer installed to $(PACKER_BIN)"

