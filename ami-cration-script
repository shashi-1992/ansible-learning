#!/bin/bash

# This is a file meant to pull all the required daemonset images and then bake it into AMI
# Itself, why? Because 
# 1. This will improve the node up time, it will not have to pull all of the daemonset images
# 2. It will also reduce our NAT gateway cost so that the images are needed to be pulled only once
#

pull_with_retry() {
    local image="$1"
    local max_retries=10
    local delay=10

    for ((attempt=1; attempt<=max_retries; attempt++)); do
        echo "🔄 Attempt $attempt: Pulling $image"
        if sudo nerdctl pull "$image"; then
            echo "✔ Success: $image"
            return 0
        else
            echo "⚠ Failed to pull $image. Retrying in $delay seconds..."
            sleep $delay
            delay=$((delay * 2))
        fi
    done

    echo "✗ ERROR: Could not pull $image after $max_retries attempts."
    return 1
}

